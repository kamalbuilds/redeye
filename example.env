# Copy to .env (gitignored) and fill in. Never commit .env.
#   cp example.env .env && chmod 600 .env

# Binance Web3 API (signed calls: Trading, Transaction, Wallet, RWA under https://web3.binance.com/build)
# Create at https://web3.binance.com/en/dev-portal/project
# Tick the capability domains: Trading, Market, Wallet, Transaction (DeFi optional).
# Used by src/exec/ for quotes, swaps, Ondo RFQ orders, simulation and broadcast.
BINANCE_W3_API_KEY=
BINANCE_W3_API_SECRET=

# Anthropic API, used by src/signals/parse.ts to turn a plain-English rule into a typed Rule.
# Optional: without it, parseRuleStrict handles the common shapes ("if TSLA drops 8% buy $50").
ANTHROPIC_API_KEY=

# Not needed here:
# - Agentic Wallet: `baw` keeps its own session after you log in with a QR scan in the Binance App.
# - Public RWA data (token list, prices, klines, market status) needs no key.
